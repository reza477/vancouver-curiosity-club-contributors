{
  "name": "vancouver-curiosity-club",
  "version": "1.0.0",
  "description": "Institutional and public-program website for Vancouver Curiosity and Education Society and Vancouver Curiosity Club.",
  "private": true,
  "license": "UNLICENSED",
  "homepage": "https://vancouvercuriosityclub.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/reza477/vancouver-curiosity-club.git"
  },
  "bugs": {
    "url": "https://github.com/reza477/vancouver-curiosity-club/issues"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/run-vinext.mjs build",
    "start": "node scripts/run-vinext.mjs start",
    "test": "node scripts/run-tests.mjs",
    "test:rendered": "node --import tsx --test tests/rendered-worker.integration.mjs",
    "bench:public": "node scripts/bench-public-routes.mjs",
    "brand:generate": "node scripts/generate-brand-artwork.mjs",
    "posters:optimize": "node scripts/generate-event-poster-formats.mjs",
    "meetup:enrichment:refresh": "node scripts/refresh-curated-meetup-enrichment.mjs && node scripts/generate-event-poster-formats.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:apply:local": "node --import tsx scripts/apply-local-migrations.mjs",
    "db:apply:preview": "node --import tsx scripts/apply-preview-migrations.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/workers-types": "5.20260822.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "axe-core": "4.12.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "image-size": "file:vendor/image-size-safe",
    "miniflare": "4.20260730.0",
    "next": "16.3.2",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.3",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.16",
    "wrangler": "4.125.0"
  },
  "overrides": {
    "image-size": "$image-size",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "miniflare@4.20260730.0": {
      "undici": "7.29.0"
    },
    "nanoid": "3.3.18"
  },
  "type": "module"
}
