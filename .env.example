# INITIAL_OWNER_EMAIL participates in owner bootstrap when a trusted Sites
# identity is present. Ordinary local Vite cannot reproduce Sites-owned auth by
# setting this value alone. Leave it empty for public-page development; use a
# synthetic or explicitly authorized value only in ignored local/Sites settings.
INITIAL_OWNER_EMAIL=

# PUBLIC_SITE_URL is the one canonical HTTPS origin used for redirects,
# metadata, exports, and scheduled updater calls. Sites may omit the binding;
# production then safely retains the current apex below.
PUBLIC_SITE_URL=https://vancouvercuriosityclub.com

# Public form submissions always commit to D1 first. These server-only values
# add a private organizer email copy through Resend; leave all three empty to
# keep the durable in-app inbox without attempting outbound delivery.
RESEND_API_KEY=
FORM_SUBMISSION_FROM_EMAIL=
FORM_SUBMISSION_TO_EMAIL=
