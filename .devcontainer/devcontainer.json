{
  "name": "Vancouver Curiosity Club contributor preview",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "remoteUser": "node",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "VCC private preview",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm ci && npm run db:apply:preview",
  "remoteEnv": {
    "__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS": ".app.github.dev"
  }
}
